# Публичный адрес сайта (используется в canonical и hreflang). Пример, замените на свой домен.
BASE_URL=https://vetlog.example.ru

# Домен для Caddy (A-запись должна указывать на сервер)
DOMAIN=

# PostgreSQL (пароль задайте сами)
POSTGRES_PASSWORD=

# Поведение приложения
MIGRATE_ON_START=true
COOKIE_SECURE=true
TRUST_PROXY=true
LOG_LEVEL=info

# SMTP: только submission-порт 587 со STARTTLS. Порт 465 (неявный TLS) не поддерживается.
# Если SMTP_HOST пуст, письма не отправляются, а логируются.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
